ाद!":[29,237024,15552],"नहीं, धन्यवाद!":[29,252576,10656],"झाँकी!":[29,263232,4608],"कौन छुपा है? छूकर देखो!":[29,267840,19008],"तुमने सबको ढूँढ लिया!":[29,286848,10512],"चटक, चटक!":[29,297360,9072],"जादुई आईना!":[29,306432,7488],"सहेज लिया! बहुत सुंदर!":[29,313920,18000],"मेरी तस्वीरें":[29,331920,7344],"चित्र बनाओ और रंग भरो":[29,339264,12240],"जादुई जानवर":[29,351504,7632],"रोशनी के पीछे चलो!":[29,359136,10944],"सुनो!":[29,370080,4320],"चलो नाचें!":[29,374400,6624],"तुमने गाना बजा दिया!":[29,381024,9216],"सच!":[30,0,4176],"कल्पना!":[30,4176,4176],"हम जो सुनते हैं, वह सब सच नहीं होता। सोचो: क्या यह सच है?":[30,8352,39024],"रोबोट को तारे तक पहुँचाओ!":[30,47376,13248],"तुम कोडर हो!":[30,60624,6480],"अरे! चलो कोड ठीक करें।":[30,67104,19152],"बाएँ":[30,86256,4608],"दाएँ":[30,90864,4896],"चलो!":[30,95760,3744],"तुमने जोड़ी ढूँढ ली!":[30,99504,10368],"तुमने सारी जोड़ियाँ ढूँढ लीं!":[30,109872,13392],"इन्हें सही क्रम में लगाओ!":[30,123264,10224],"उँगली से बनाओ!":[30,133488,7920],"कितनी सुंदर लिखावट!":[30,141408,9216],"फूल को सूँघो। साँस अंदर लो।":[30,150624,22032],"मोमबत्ती बुझाओ। साँस बाहर छोड़ो।":[30,172656,25488],"शाबाश। अब तुम शांत हो।":[30,198144,19872],"चलो साथ में साँस लें।":[30,218016,11664],"नमस्ते! चलो खेलें!":[30,229680,16848],"Wonder World में स्वागत है!":[30,246528,10800],"तुम्हारे लिए एक सितारा!":[30,257328,10800],"अनलॉक करने के लिए किसी बड़े से पूछो।":[30,268128,16560],"शाबाश!":[30,284688,5328],"तुमने ढूँढ लिया!":[30,290016,7488],"बहुत बढ़िया!":[30,297504,6336],"तुम कितने होशियार हो!":[30,303840,9504],"ताली दो!":[30,313344,5040],"कमाल है!":[30,318384,4752],"बहुत ख़ूब!":[30,323136,5616],"तुमने कर दिखाया!":[30,328752,7344]}}
76],"Now they are both happy. Sharing is caring. The end.":[27,189072,24768],"Robo Asks Why":[27,213840,9360],"Robo is a little robot.":[27,223200,10944],"Robo sees a rainbow and wonders, why?":[27,234144,16416],"Robo asks a question. Good questions help us learn.":[27,250560,23040],"Robo reads a book with a grown-up.":[27,273600,12096],"Sunlight and raindrops make rainbows. Now Robo knows!":[27,285696,25776],"Keep asking why. That is how we grow smart. The end.":[27,311472,25776],"Animals":[27,337248,5040],"Animal Museum":[27,342288,7056],"Wild Adventure":[27,349344,7488],"Magic Pond":[27,356832,7920],"Coral Reef":[27,364752,6192],"Peekaboo":[27,370944,4752],"Feed Me":[27,375696,4608],"Play World":[27,380304,5616],"Life Cycles":[27,385920,7056],"Letters & Reading":[27,392976,7632],"ABC":[27,400608,5904],"Trace Letters":[27,406512,6336],"First Sounds":[27,412848,6048],"Story Time":[27,418896,6480],"Numbers & Math":[27,425376,7776],"Counting":[27,433152,4752],"Trace Numbers":[27,437904,6912],"How Many?":[27,444816,4176],"More or Less":[27,448992,6768],"Add & Take Away":[28,0,7776],"Shapes":[28,7776,4320],"Patterns":[28,12096,5040],"Thinking Lab":[28,17136,5472],"Real or Pretend?":[28,22608,9360],"Robot Coder":[28,31968,6480],"Odd One Out":[28,38448,5472],"Memory Match":[28,43920,6336],"What Would You Do?":[28,50256,6336],"Find It!":[28,56592,4032],"Discover":[28,60624,5040],"Colors":[28,65664,4608],"Weather & Seasons":[28,70272,8640],"My Body":[28,78912,5328],"Five Senses":[28,84240,6768],"Opposites":[28,91008,5184],"Things That Go":[28,96192,5904],"Fruits & Veggies":[28,102096,8640],"Hello, World!":[28,110736,6624],"Feelings & Kindness":[28,117360,11088],"Love & Manners":[28,128448,8496],"Feelings":[28,136944,5184],"Calm Breathing":[28,142128,6768],"Create":[28,148896,3600],"Art Studio":[28,152496,5760],"Music Studio":[28,158256,7200],"Bubbles":[28,165456,4464],"Pets":[28,169920,4032],"Jungle & Safari":[28,173952,9648],"Forest":[28,183600,5040],"Ocean & Ice":[28,188